<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>KeyboardSound.Core</RootNamespace>
    <Platforms>x64</Platforms>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <!-- See KeyboardSound.App.csproj: Release publishes should never carry .pdb files with
       embedded developer source paths. -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <!-- Decodes .ogg samples (the format many freely-licensed sound libraries ship in,
         e.g. Kenney's CC0 packs) without relying on OS codecs, which aren't guaranteed
         to include Vorbis support. -->
    <PackageReference Include="NAudio.Vorbis" Version="1.5.0" />
  </ItemGroup>

</Project>
