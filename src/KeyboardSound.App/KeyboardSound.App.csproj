<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\KeyboardSound.Core\KeyboardSound.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>KeyboardSound</AssemblyName>
    <RootNamespace>KeyboardSound.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <Product>KeyboardSound</Product>
    <AssemblyTitle>KeyboardSound</AssemblyTitle>
    <Platforms>x64</Platforms>
    <SelfContained>false</SelfContained>
    <!-- WFAC010: WinForms' high-DPI analyzer flags the manifest's dpiAware setting, but DPI
         here is driven by WPF (which reads the manifest directly); WinForms is only used for
         the tray icon, which has no DPI-sensitive UI of its own. -->
    <NoWarn>WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\assets\soundpacks\**\*" LinkBase="soundpacks">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>soundpacks\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Same .ico embedded here as a WPF resource (for the runtime window/tray icon) is also
         referenced by ApplicationIcon above (for the EXE's Win32 icon resource), so there is
         exactly one icon asset and both the file and the running app show the same artwork. -->
    <Resource Include="Resources\app.ico" />
    <!-- Transparent-background rendition of the same mark, sized for the small desktop widget,
         which draws its own rounded surface/border rather than reusing the icon's dark square. -->
    <Resource Include="Resources\widget-mark.png" />
  </ItemGroup>

</Project>
