<Window x:Class="KeyboardSound.App.Ui.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:KeyboardSound.App.Ui"
        Title="Welcome to KeyboardSound"
        Width="420" Height="520"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel x:Name="StepWelcome" Grid.Row="0">
            <TextBlock Text="Welcome to KeyboardSound" Style="{StaticResource TitleTextStyle}" FontSize="22" Margin="0,0,0,12" TextWrapping="Wrap"/>
            <TextBlock Text="A few quick steps to get your keyboard sounds set up just the way you like. You can change any of this later in Settings."
                       Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel x:Name="StepSound" Grid.Row="0" Visibility="Collapsed">
            <TextBlock Text="Choose your sound" Style="{StaticResource TitleTextStyle}" FontSize="18" Margin="0,0,0,4"/>
            <TextBlock Text="Preview a few and pick your favorite." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <ItemsControl x:Name="OnboardingSoundList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type ui:SoundRow}">
                        <Border Style="{StaticResource ListRowStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Tag="{Binding Id}" Click="OnboardingPreview_Click"
                                        Width="28" Height="28" Margin="0,0,8,0"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        Content="&#x25B6;" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center"/>
                                <Button Grid.Column="2" Tag="{Binding Id}" Click="OnboardingSelect_Click"
                                        Content="{Binding IsSelected, Converter={StaticResource SelectedLabelConverter}}"
                                        Style="{StaticResource GhostButtonStyle}"
                                        IsEnabled="{Binding IsSelected, Converter={StaticResource InverseBoolConverter}}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <StackPanel x:Name="StepKeyMode" Grid.Row="0" Visibility="Collapsed">
            <TextBlock Text="Keyboard mode" Style="{StaticResource TitleTextStyle}" FontSize="18" Margin="0,0,0,4"/>
            <TextBlock Text="Play a sound for every key, or only the ones you choose."
                       Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <RadioButton x:Name="OnboardingAllKeysRadio" Content="All Keys" GroupName="OnboardingKeyMode" Margin="0,0,0,10" IsChecked="True"/>
            <RadioButton x:Name="OnboardingCustomKeysRadio" Content="Custom Keys (choose exactly which, later in Settings)" GroupName="OnboardingKeyMode"/>
        </StackPanel>

        <StackPanel x:Name="StepWidget" Grid.Row="0" Visibility="Collapsed">
            <TextBlock Text="Desktop widget" Style="{StaticResource TitleTextStyle}" FontSize="18" Margin="0,0,0,4"/>
            <TextBlock Text="A small, draggable icon that stays on your desktop - click it anytime to open Settings."
                       Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <RadioButton x:Name="OnboardingWidgetShowRadio" Content="Show Widget" GroupName="OnboardingWidget" Margin="0,0,0,10" IsChecked="True"/>
            <RadioButton x:Name="OnboardingWidgetHideRadio" Content="Hide Widget" GroupName="OnboardingWidget"/>
        </StackPanel>

        <StackPanel x:Name="StepStartup" Grid.Row="0" Visibility="Collapsed">
            <TextBlock Text="Windows startup" Style="{StaticResource TitleTextStyle}" FontSize="18" Margin="0,0,0,4"/>
            <TextBlock Text="Launch KeyboardSound automatically whenever Windows starts."
                       Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <RadioButton x:Name="OnboardingStartWithWindowsRadio" Content="Start with Windows" GroupName="OnboardingStartup" Margin="0,0,0,10"/>
            <RadioButton x:Name="OnboardingDontStartRadio" Content="Don't start with Windows" GroupName="OnboardingStartup" IsChecked="True"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Grid.Column="0" Content="Back" Click="Back_Click"
                    Style="{StaticResource GhostButtonStyle}" Visibility="Collapsed"/>
            <TextBlock x:Name="StepIndicatorText" Grid.Column="1" Style="{StaticResource MutedTextStyle}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Button x:Name="NextButton" Grid.Column="2" Content="Next" Click="Next_Click"
                    Style="{StaticResource AccentButtonStyle}"/>
        </Grid>
    </Grid>
</Window>
