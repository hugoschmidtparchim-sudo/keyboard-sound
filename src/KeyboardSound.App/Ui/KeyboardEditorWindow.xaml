<Window x:Class="KeyboardSound.App.Ui.KeyboardEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:KeyboardSound.App.Ui"
        Title="Keyboard Editor"
        Width="1440" Height="620"
        MinWidth="1180" MinHeight="560"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Keyboard Editor" Style="{StaticResource TitleTextStyle}" FontSize="18"/>
            <TextBlock Text="Click a key (or several) to select it, then assign a sound below. A key with no assignment plays your global sound."
                       Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,0,14,0">
                <StackPanel x:Name="KeyboardHost" Orientation="Horizontal"/>
            </ScrollViewer>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="SELECTION" Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBlock x:Name="SelectionSummaryText" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="All" Click="SelectAll_Click" Style="{StaticResource GhostButtonStyle}" Padding="10,4" FontSize="11" Margin="0,0,6,0"/>
                            <Button Content="Clear" Click="ClearSelection_Click" Style="{StaticResource GhostButtonStyle}" Padding="10,4" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="ASSIGN SOUND" Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBlock x:Name="NoSelectionHintText" Text="Select at least one key first."
                                   Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,8"/>
                        <ItemsControl x:Name="AssignSoundList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type ui:SoundRow}">
                                    <Border Style="{StaticResource ListRowStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Tag="{Binding Id}" Click="EditorPreview_Click"
                                                    Width="24" Height="24" Margin="0,0,6,0"
                                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                    Content="&#x25B6;" FontSize="10" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Style="{StaticResource BodyTextStyle}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <Button Grid.Column="2" Tag="{Binding Id}" Click="EditorApply_Click"
                                                    Content="{Binding IsSelected, Converter={StaticResource SelectedLabelConverter}}"
                                                    Style="{StaticResource GhostButtonStyle}" Padding="8,4" FontSize="11"
                                                    IsEnabled="{Binding IsSelected, Converter={StaticResource InverseBoolConverter}}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Use Global Sound" Click="UseGlobalSound_Click"
                                Style="{StaticResource GhostButtonStyle}" Padding="10,6" Margin="0,8,0,0" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="A key with a colored ring already has a custom sound. Selected keys are filled blue."
                                   Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <Button Content="Reset Custom Keys" Click="ResetCustomKeys_Click"
                                Style="{StaticResource GhostButtonStyle}" Padding="10,6" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
