<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\KeyboardSound.Core\KeyboardSound.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>KeyboardSound</AssemblyName>
    <RootNamespace>KeyboardSound.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <Product>KeyboardSound</Product>
    <AssemblyTitle>KeyboardSound</AssemblyTitle>
    <Version>1.0.0</Version>
    <Platforms>x64</Platforms>
    <SelfContained>false</SelfContained>
    <!-- WFAC010: WinForms' high-DPI analyzer flags the manifest's dpiAware setting, but DPI
         here is driven by WPF (which reads the manifest directly); WinForms is only used for
         the tray icon, which has no DPI-sensitive UI of its own. -->
    <NoWarn>WFAC010</NoWarn>
  </PropertyGroup>

  <!-- Release publishes should never carry .pdb files - they embed the developer's local source
       paths, which have no reason to ship in a distributed build (Steam or otherwise). Debug
       keeps full symbols since they're needed for local debugging. -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\assets\soundpacks\**\*" LinkBase="soundpacks">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>soundpacks\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Same .ico embedded here as a WPF resource (for the runtime window/tray icon) is also
         referenced by ApplicationIcon above (for the EXE's Win32 icon resource), so there is
         exactly one icon asset and both the file and the running app show the same artwork.
         Every size in it is a plain high-quality resize of the complete source image - no
         cropping, no simplified redraw - per an explicit instruction to keep the full image
         intact rather than deriving a simplified mark from it. -->
    <Resource Include="Resources\app.ico" />
    <!-- The same complete image at a resolution high enough to scale down cleanly for the
         small desktop widget's Image control. -->
    <Resource Include="Resources\widget-logo.png" />
  </ItemGroup>

</Project>
