<Application x:Class="KeyboardSound.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:KeyboardSound.App"
             xmlns:ui="clr-namespace:KeyboardSound.App.Ui"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <ui:FavoriteGlyphConverter x:Key="FavoriteGlyphConverter"/>
            <ui:ActiveLabelConverter x:Key="ActiveLabelConverter"/>
            <ui:SelectedLabelConverter x:Key="SelectedLabelConverter"/>
            <ui:InverseBoolConverter x:Key="InverseBoolConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
